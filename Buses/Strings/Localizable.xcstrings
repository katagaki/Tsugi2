        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் இருப்பிடம் கிடைக்கவில்லை. Buses ஐத் திறந்து உங்கள் இருப்பிடத்தைப் பயன்படுத்த அனுமதிக்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถระบุตำแหน่งของคุณได้ เปิด Buses และอนุญาตให้ใช้ตำแหน่งของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không xác định được vị trí của bạn. Hãy mở Buses và cho phép sử dụng vị trí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
