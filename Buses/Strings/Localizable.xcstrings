            "value" : "பேருந்து வருகை நேரங்களை ஏற்ற முடியவில்லை. உங்கள் இணைய இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถโหลดเวลารถเมล์มาถึงได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tải giờ xe buýt đến. Hãy kiểm tra kết nối internet và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载巴士到站时间。请检查网络连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入巴士到站時間。請檢查網絡連線後再試一次。"
          }
        }
      }
    },
    "Intents.Error.LocationUnavailable" : {
      "comment" : "Siri error",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
