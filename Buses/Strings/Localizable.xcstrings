    "Nearby.Hint.NoLocation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "device" : {
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Location Services are not enabled. Select the button below to tell Buses your location without enabling Location Services."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Location Services are not enabled."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "device" : {
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "位置情報の設定が無効化されています。一時的に位置情報を共有するには、下のボタンを選択してください。"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "位置情報の設定が無効化されています。一時的に位置情報を共有するには、下のボタンを選択してください。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "device" : {
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "위치 서비스가 활성화되어 있지 않습니다. 위치 서비스를 활성화하지 않고 Buses에 위치를 알리려면 아래 버튼을 선택하세요."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "위치 서비스가 활성화되어 있지 않습니다."
                }
              }
            }
          }
        },
        "ms" : {
          "variations" : {
            "device" : {
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Perkhidmatan Lokasi tidak diaktifkan. Pilih butang di bawah untuk memberitahu Buses lokasi anda tanpa mengaktifkan Perkhidmatan Lokasi."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Perkhidmatan Lokasi tidak diaktifkan."
                }
              }
            }
          }
        },
        "ta" : {
          "variations" : {
            "device" : {
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "இருப்பிடச் சேவைகள் இயக்கப்படவில்லை. இருப்பிடச் சேவைகளை இயக்காமல் Buses-க்கு உங்கள் இருப்பிடத்தைத் தெரிவிக்க கீழே உள்ள பொத்தானைத் தேர்ந்தெடுக்கவும்."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "இருப்பிடச் சேவைகள் இயக்கப்படவில்லை."
                }
              }
            }
          }
        },
        "th" : {
          "variations" : {
            "device" : {
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "บริการตำแหน่งที่ตั้งไม่ได้เปิดใช้งาน เลือกปุ่มด้านล่างเพื่อบอกตำแหน่งที่ตั้งของคุณให้ Buses โดยไม่ต้องเปิดใช้งานบริการตำแหน่งที่ตั้ง"
                }
              },
